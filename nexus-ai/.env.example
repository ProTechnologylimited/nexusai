# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexus_ai"

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Required when self-hosting behind a proxy (not needed on Vercel)
# AUTH_TRUST_HOST=true

# Not used yet (later phases): AI provider, email provider, payment provider

# AI provider (Anthropic). Required to create and run agents.
ANTHROPIC_API_KEY=""

# Secret for the workflow worker endpoint (min 16 chars). Scheduler must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Email sending (Resend). All four are required before any email can be sent.
RESEND_API_KEY=""
EMAIL_FROM=""            # e.g. "Acme <hello@yourdomain.com>" on a domain verified in Resend
EMAIL_FOOTER_ADDRESS=""  # your business postal address, added to every email (anti-spam law)
APP_URL=""               # public base URL, e.g. https://app.example.com (used in unsubscribe links)

# Billing (Stripe). Create products/prices in Stripe, then set the price ids below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""     # signing secret for the endpoint {APP_URL}/api/webhooks/stripe
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_BUSINESS=""
# Webhook events to enable in Stripe: customer.subscription.created, .updated, .deleted

# Optional: publishes a contact address on /contact. Leave blank to show a "not published" notice.
NEXT_PUBLIC_CONTACT_EMAIL=""
